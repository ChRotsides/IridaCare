# Copy to .env and fill in. Never commit .env.

# Camera account (Tapo app > camera > Advanced settings > Camera account)
TAPO_HOST=192.168.x.x
TAPO_USER=
TAPO_PASSWORD=

# Optional: your Tapo cloud password. Needed for the speaker, and for privacy mode
# and the status light if the camera account is rejected.
TAPO_CLOUD_PASSWORD=

# Optional: web UI port (default 8080)
TAPO_PORT=8080

# Optional: enables the voice assistant
OPENAI_API_KEY=

# Optional: extra Host headers to accept, comma-separated (e.g. a tailscale serve name)
TAPO_EXTRA_HOSTS=
